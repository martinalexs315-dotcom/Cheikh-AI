rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['createdAt', 'updatedAt']) 
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && (data.keys().hasOnly(['createdAt', 'updatedAt', 'email', 'displayName', 'photoURL', 'hasCompletedOnboarding']))
        && (!("email" in data) || (data.email is string && data.email.size() <= 255))
        && (!("displayName" in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!("photoURL" in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && (!("hasCompletedOnboarding" in data) || data.hasCompletedOnboarding is bool);
    }
    
    function isValidUserUpdate(data) {
      return data.updatedAt == request.time
        && (data.keys().hasOnly(['updatedAt', 'email', 'displayName', 'photoURL', 'createdAt', 'hasCompletedOnboarding']))
        && data.createdAt == existing().createdAt
        && (!("email" in data) || (data.email is string && data.email.size() <= 255))
        && (!("displayName" in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!("photoURL" in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && (!("hasCompletedOnboarding" in data) || data.hasCompletedOnboarding is bool);
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['userId', 'title', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'createdAt', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.title is string && data.title.size() <= 200
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidConversationUpdate(data) {
      return data.updatedAt == request.time
        && data.keys().hasOnly(['id', 'userId', 'title', 'createdAt', 'updatedAt'])
        && data.userId == existing().userId
        && data.createdAt == existing().createdAt
        && data.title is string && data.title.size() <= 200;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['conversationId', 'userId', 'role', 'content', 'createdAt'])
        && data.keys().hasOnly(['id', 'conversationId', 'userId', 'role', 'content', 'createdAt', 'sources', 'isClarification', 'clarificationOptions'])
        && data.userId == request.auth.uid
        && isValidId(data.conversationId)
        && data.role is string && data.role in ['user', 'assistant', 'system', 'model']
        && data.content is string && data.content.size() <= 50000
        && data.createdAt == request.time
        && (!("sources" in data) || data.sources == null || data.sources is list)
        && (!("isClarification" in data) || data.isClarification is bool)
        && (!("clarificationOptions" in data) || data.clarificationOptions == null || data.clarificationOptions is list);
    }

    // Rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) 
        && isValidId(userId) 
        && isValidUser(incoming())
        && request.auth.token.email_verified == true;
      allow update: if isOwner(userId) 
        && isValidId(userId) 
        && isValidUserUpdate(incoming())
        && request.auth.token.email_verified == true
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'updatedAt', 'hasCompletedOnboarding']);
    }

    match /conversations/{conversationId} {
      allow get: if isSignedIn() && isValidId(conversationId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(conversationId)
        && isValidConversation(incoming())
        && request.auth.token.email_verified == true;
      allow update: if isSignedIn()
        && isValidId(conversationId)
        && existing().userId == request.auth.uid
        && isValidConversationUpdate(incoming())
        && request.auth.token.email_verified == true
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(conversationId) && existing().userId == request.auth.uid;
    }

    match /messages/{messageId} {
      allow get: if isSignedIn() && isValidId(messageId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(messageId)
        && isValidMessage(incoming())
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/conversations/$(incoming().conversationId))
        && get(/databases/$(database)/documents/conversations/$(incoming().conversationId)).data.userId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(messageId) && existing().userId == request.auth.uid;
    }
  }
}
